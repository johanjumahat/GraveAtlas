{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Record",
  "description": "A source reference for factual claims in GraveAtlas",
  "type": "object",
  "required": ["id", "title", "submittedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^source_[a-z0-9]{16,64}$" },
    "title": { "type": "string", "maxLength": 500 },
    "sourceType": {
      "type": "string",
      "enum": ["cemetery_record", "official_record", "public_record", "historical_document", "photograph", "contributor_provided", "other"]
    },
    "url": { "type": ["string", "null"], "maxLength": 2000, "pattern": "^https?://" },
    "attribution": { "type": ["string", "null"], "maxLength": 2000, "description": "Required attribution text" },
    "license": { "type": ["string", "null"], "maxLength": 500, "description": "License or usage permission" },
    "importDate": { "type": ["string", "null"], "format": "date-time" },
    "datasetVersion": { "type": ["string", "null"], "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "submittedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
