# GraveAtlas Environment Configuration
# ──────────────────────────────────────
# This file contains PLACEHOLDER values only.
# NEVER commit real secrets to the repository.

# Backend API URL (Cloudflare Worker)
API_BASE_URL=https://graveatlas-backend.YOUR-SUBDOMAIN.workers.dev

# GitHub App credentials (backend only — NEVER in Android)
GITHUB_APP_ID=YOUR_APP_ID
GITHUB_PRIVATE_KEY=YOUR_PRIVATE_KEY
GITHUB_INSTALLATION_ID=YOUR_INSTALLATION_ID
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO=kubur-sg-data
GITHUB_BRANCH=main

# Admin
ADMIN_TOKEN=YOUR_ADMIN_TOKEN
