<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- ===== TOP BAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GraveAtlas"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- ===== INFO CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Subtitle -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discover, record, and search public cemetery information"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_dark"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Data summary -->
                <TextView
                    android:id="@+id/summaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark"
                    android:gravity="center"
                    android:layout_marginBottom="4dp"
                    android:text="—" />

                <TextView
                    android:id="@+id/summaryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted_dark"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="graves in database"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/summaryProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== QUICK ACTIONS GRID ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted_dark"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Row 1: Search Graves, Browse Map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/quickSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_nav_search"
                    android:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Graves"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_nav_map"
                    android:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse Map"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Add Grave, AI Chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/quickAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_more_add"
                    android:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add a Grave"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_more_chat"
                    android:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Chat"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
