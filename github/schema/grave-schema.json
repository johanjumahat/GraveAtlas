{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grave Record",
  "description": "A single grave record in the GraveAtlas database",
  "type": "object",
  "required": ["id", "name", "status", "submittedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the grave record",
      "pattern": "^[a-z0-9]{8,64}$"
    },
    "name": {
      "type": "string",
      "maxLength": 500,
      "description": "Name of the deceased"
    },
    "birthDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Birth date in YYYY-MM-DD format (optional)"
    },
    "deathDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Death date in YYYY-MM-DD format (optional)"
    },
    "cemetery": {
      "type": ["string", "null"],
      "maxLength": 2000,
      "description": "Cemetery name (optional)"
    },
    "section": {
      "type": ["string", "null"],
      "maxLength": 2000,
      "description": "Section within cemetery (optional)"
    },
    "plot": {
      "type": ["string", "null"],
      "maxLength": 2000,
      "description": "Plot number or identifier (optional)"
    },
    "latitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90,
      "description": "GPS latitude (optional)"
    },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180,
      "description": "GPS longitude (optional)"
    },
    "photoRefs": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "References to photo files in the photos/ directory (optional)"
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000,
      "description": "Additional notes (optional)"
    },
    "source": {
      "type": ["string", "null"],
      "description": "Source of the record — user submission, official record, etc."
    },
    "status": {
      "type": "string",
      "enum": ["published", "pending", "rejected", "reported"],
      "description": "Current status of the record"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of submission"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO timestamp of last update (optional)"
    }
  },
  "additionalProperties": false
}
