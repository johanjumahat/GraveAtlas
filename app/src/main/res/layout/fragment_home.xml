<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- ===== TOP BAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GraveAtlas"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"
                android:letterSpacing="0.08" />

            <ImageButton
                android:id="@+id/gpsIconBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_gps"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Detect my location"
                app:tint="@color/gold" />
        </LinearLayout>

        <!-- ===== RESEARCH DROPDOWN ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What would you like to investigate?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT RESEARCH TOPIC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted_dark"
            android:letterSpacing="0.1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerResearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:popupBackground="@color/bg_surface_2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiAsk"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Start Research"
            android:textSize="14sp"
            android:textColor="@color/bg_root"
            app:backgroundTint="@color/gold"
            app:cornerRadius="22dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="12dp"
            app:icon="@android:drawable/ic_menu_send"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconTint="@color/bg_root" />

        <!-- ===== LOCATION CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/locationDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/gold_light"
                    android:gravity="center"
                    android:text="Tap GPS icon to detect your location"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Country"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted_dark"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerCountry"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/stateGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State / Province"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted_dark"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/spinnerState"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted_dark"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerCity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/gpsProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== QUICK ACTIONS GRID ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted_dark"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Row 1: Search Graves, Browse Map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/quickSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_nav_search"
                    app:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Graves"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_nav_map"
                    app:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse Map"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Add Grave, AI Chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/quickAdd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_more_add"
                    app:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add a Grave"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:descendantFocusability="blocksDescendants"
                android:padding="16dp"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_more_chat"
                    app:tint="@color/gold"
                    android:scaleType="centerInside"
                    android:clickable="false" android:focusable="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Chat"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="6dp"
                    android:clickable="false" android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
