<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GraveAtlas" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_dim</item>
        <item name="colorOnPrimary">@color/bg_root</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/bg_root</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_root</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_root</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>

    <!-- Splash screen theme (Phase 8) -->
    <style name="Theme.GraveAtlas.Splash" parent="Theme.GraveAtlas">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
    </style>
</resources>
