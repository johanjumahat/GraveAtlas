<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:gravity="center"
    android:padding="32dp">

    <!-- Logo / App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GraveAtlas"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/gold"
        android:letterSpacing="0.05" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Explore the haunted unknown"
        android:textSize="14sp"
        android:textColor="@color/text_secondary_dark" />

    <View
        android:layout_width="48dp"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="48dp"
        android:background="@color/gold_dim" />

    <!-- Google Sign-In button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:text="Sign in with Google"
        android:textSize="15sp"
        android:textColor="@color/text_primary_dark"
        app:icon="@drawable/ic_google_signin"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconTint="@color/gold"
        app:backgroundTint="@color/bg_surface"
        app:strokeColor="@color/gold_dim"
        app:strokeWidth="1dp"
        app:cornerRadius="26dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/loginProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        android:indeterminateTint="@color/gold" />

    <!-- Error message -->
    <TextView
        android:id="@+id/tvLoginError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/danger"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Privacy note -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Your data is encrypted and stored securely on your device."
        android:textSize="11sp"
        android:textColor="@color/text_muted_dark"
        android:gravity="center" />

</LinearLayout>
